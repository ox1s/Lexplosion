<UserControl
    x:Class="Lexplosion.UI.WPF.Controls.BindablePasswordBox"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:extensions="clr-namespace:Lexplosion.UI.WPF.Extensions"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    FocusVisualStyle="{x:Null}"
    mc:Ignorable="d">

    <Grid>
        <Border
            x:Name="Border"
            Background="Transparent"
            BorderBrush="{DynamicResource SeparateSolidColorBrush}"
            BorderThickness="2"
            CornerRadius="5" />

        <Border
            x:Name="BorderFocused"
            Background="Transparent"
            BorderBrush="{DynamicResource ActivitySolidColorBrush}"
            BorderThickness="2"
            CornerRadius="5"
            Opacity="0" />

        <Border
            Padding="12,4,12,4"
            BorderBrush="Transparent"
            BorderThickness="2"
            CornerRadius="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Margin="0,-22,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{DynamicResource SecondaryForegroundSolidColorBrush}"
                    Text="{Binding Placeholder, RelativeSource={RelativeSource AncestorType=UserControl}}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Placeholder, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Placeholder, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <PasswordBox
                    x:Name="passwordBox"
                    Grid.Column="0"
                    Style="{x:Null}"
                    Margin="0"
                    Padding="0"
                    VerticalAlignment="Bottom"
                    Background="Transparent"
                    BorderThickness="0"
                    CaretBrush="{DynamicResource ActivitySolidColorBrush}"
                    FontFamily="Verdana"
                    FontSize="14"
                    Foreground="{DynamicResource PrimaryForegroundSolidColorBrush}"
                    GotFocus="Input_GotFocus"
                    LostFocus="Input_LostFocus"
                    PasswordChanged="PasswordBox_PasswordChanged"
                    PasswordChar="*" />

                <TextBox
                    x:Name="visibleBox"
                    Grid.Column="0"
                    Style="{x:Null}"
                    Margin="0"
                    Padding="0"
                    VerticalAlignment="Bottom"
                    Background="Transparent"
                    BorderThickness="0"
                    CaretBrush="{DynamicResource ActivitySolidColorBrush}"
                    FontFamily="Verdana"
                    FontSize="14"
                    FocusVisualStyle="{x:Null}"
                    Foreground="{DynamicResource PrimaryForegroundSolidColorBrush}"
                    GotFocus="Input_GotFocus"
                    LostFocus="Input_LostFocus"
                    TextChanged="VisibleBox_TextChanged"
                    Visibility="Collapsed" />

                <Button
                    x:Name="toggleButton"
                    Grid.Column="1"
                    Width="34"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="ToggleButton_Click"
                    Cursor="Hand"
                    FocusVisualStyle="{x:Null}"
                    Opacity="0.45">
                    <Button.Style>
                        <Style TargetType="{x:Type Button}">
                            <Setter Property="OverridesDefaultStyle" Value="True" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type Button}">
                                        <Border Background="Transparent">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Opacity" Value="1" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Viewbox Width="16" Height="16">
                        <Path
                            x:Name="eyeIcon"
                            extensions:PathExtensions.StringKeyData="EyeHidden"
                            Fill="{DynamicResource PrimaryForegroundSolidColorBrush}"
                            Stretch="Uniform" />
                    </Viewbox>
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>